# Portfolio Watchdog Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit real keys to this file - it is the shared template.

# Gemini API keys, comma-separated, in rotation order.
# Get keys from https://aistudio.google.com/apikey
#
# The agent uses one key at a time and stays on it until that key returns a
# 429 / RESOURCE_EXHAUSTED quota error, at which point it advances to the next
# key in the list and retries the same request. Any other failure (401 auth,
# network timeout) does NOT rotate, since a different key would not fix it.
#
# Note: the free-tier quota is enforced per Google Cloud *project*, not per key,
# so multiple keys only add capacity if they belong to different projects.
#
# Example with three keys:
#   GEMINI_API_KEYS=AIzaKey1Here,AIzaKey2Here,AIzaKey3Here
GEMINI_API_KEYS=your-first-key-here,your-second-key-here

# Deprecated single-key fallback, kept for backwards compatibility.
# Used only when GEMINI_API_KEYS is unset or empty.
# GEMINI_API_KEY=your-key-here

# --- Automatic cycle scheduler ---------------------------------------------
# When enabled, the backend runs monitoring cycles on a schedule with nobody
# pressing Run Cycle. Cycles are spread evenly across the regular US trading
# session (09:30-16:00 ET), weekdays only - running overnight or at weekends
# would spend quota re-reading the same unchanged daily bars.
# Market holidays are NOT skipped.
AUTO_RUN_ENABLED=false

# Cycles per trading day. 8 fires at:
#   09:30  10:19  11:08  11:56  12:45  13:34  14:22  15:11  ET
#
# QUOTA MATH - read before raising this:
#   requests/day = AUTO_RUN_PER_DAY x number of watchlist tickers
#   8 runs x 5 tickers = 40 requests/day.
#   Each Gemini free-tier PROJECT allows 20/day, so 3 keys from 3 different
#   projects supply 60/day - leaving 20 spare for manual runs during a demo.
#   Raising this to 12 would consume all 60 and leave nothing in reserve.
AUTO_RUN_PER_DAY=8

# Fire one cycle ~5s after startup instead of waiting for the next slot.
# Handy for demos; costs one cycle's quota on every restart.
AUTO_RUN_ON_STARTUP=false

# Optional: Comma-separated list of allowed CORS origins
# Defaults to * (all origins) if not set
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
ALLOWED_ORIGINS=*
